# PawClock environment variables (Expo).
#
# Copy this file to `.env.local` (gitignored) and fill in real values. Only vars prefixed
# with EXPO_PUBLIC_ are inlined into the client bundle, so NEVER put a service_role key here
# — the anon / publishable key is the only Supabase key that is client-safe by design.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / publishable key. The new `sb_publishable_...` format works as the anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Master switch for the synced (Supabase) repo. Keep "false" to run fully local & offline
# (the default). Flip to "true" only once anonymous sign-ins are enabled on the backend and
# SYNC-1 has been verified end-to-end.
EXPO_PUBLIC_USE_SUPABASE=false
