# PawClock environment variables (Expo).
#
# Copy this file to `.env.local` (gitignored) and fill in real values. Only vars prefixed
# with EXPO_PUBLIC_ are inlined into the client bundle, so NEVER put a service_role key here
# — the anon / publishable key is the only Supabase key that is client-safe by design.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / publishable key. The new `sb_publishable_...` format works as the anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Master switch for the synced (Supabase) repo. "false" runs fully local and offline, with
# this device scheduling its own reminders — still the default, and still a complete app.
#
# "true" additionally turns on SYNC-2: the device registers an Expo push token and the
# BACKEND takes over scheduling, so a prediction reaches every caregiver's phone rather than
# just the one that computed it. Local scheduling is switched off at that point to avoid
# every reminder arriving twice.
#
# Prerequisites, both now met on staging: anonymous sign-ins enabled (config push, not db
# push), and a physical device — Expo cannot issue a push token to a simulator, so a
# simulator silently stays on local scheduling.
EXPO_PUBLIC_USE_SUPABASE=false
