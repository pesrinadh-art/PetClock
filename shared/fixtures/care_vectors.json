      "expected": {
        "anchor": "2026-06-15T14:00:00.000Z",
        "dueAt": "2026-06-15T18:00:00.000Z",
        "notifyAt": "2026-06-15T17:40:00.000Z",
        "bufferMinutes": 20,
        "overdueBy": 0
      }
    },
